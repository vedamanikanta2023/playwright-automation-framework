{
  "name": "playwright-automation-framework",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript Playwright framework for UI, API and E2E automation",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/UI",
    "test:api": "playwright test tests/API",
    "test:e2e": "playwright test tests/E2E",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:slow": "playwright test --headed --workers=1",
    "report": "playwright show-report playwright-reports",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
